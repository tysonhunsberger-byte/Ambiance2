/* Generated from CSS via css_to_qss.py (prototype). */

QMdiSubWindow {
    font: 9pt "Segoe UI", "SegoeUI", "Noto Sans", sans-serif;
    border-radius: 10px;
    border: 1px solid rgba(60, 100, 150, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.95);
    border-left: 1px solid rgba(255, 255, 255, 0.85);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.94),
        stop:0.12 rgba(245, 250, 255, 0.9),
        stop:0.6 rgba(210, 230, 255, 0.75),
        stop:1 rgba(184, 210, 252, 0.7));
    padding: 6px;
}

QMdiSubWindow QWidget#qt_scrollarea_viewport {
    background-color: #f7fbff;
    border: 1px solid #b3c7e3;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #e5efff;
    border-radius: 0px 0px 7px 7px;
    padding: 10px;
}

QMdiSubWindow::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(210, 230, 255, 0.8),
        stop:1 rgba(180, 210, 245, 0.75));
    border: 1px solid rgba(46, 93, 166, 0.85);
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    font: 10pt "Segoe UI Semibold", "Segoe UI", sans-serif;
    padding: 6px 18px;
    color: #102a56;
}

QMdiSubWindow::title:inactive {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(210, 220, 235, 0.7),
        stop:1 rgba(180, 195, 220, 0.6));
    border: 1px solid rgba(120, 147, 191, 0.7);
    border-bottom: none;
    color: rgba(20, 36, 64, 0.75);
}
